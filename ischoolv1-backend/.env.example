# local | preview | staging | production | test
APP_ENV=local
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# App traffic (may go through a pooler in hosted environments).
DATABASE_URL=postgresql://ischool:ischool@localhost:5433/ischool
# Migrations and the pg-boss job queue (never through a transaction pooler).
DATABASE_DIRECT_URL=postgresql://ischool:ischool@localhost:5433/ischool

# S3-compatible object storage (Cloudflare R2 in hosted environments, RustFS locally).
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=ischool-files
STORAGE_ACCESS_KEY_ID=ischool
STORAGE_SECRET_ACCESS_KEY=ischool-secret
STORAGE_FORCE_PATH_STYLE=true
