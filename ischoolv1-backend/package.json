    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pino-pretty": "^13.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
